# LLM — Step 1 (scraping) needs NO key. Fill this in before Step 3.
# Groq (https://console.groq.com/keys — free tier):
GROQ_API_KEY=your_groq_key_here
# GROQ_MODEL=openai/gpt-oss-120b

# LangSmith (optional but recommended for tracing/eval — Step 5)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_key_here
LANGCHAIN_PROJECT=app-review-insights-agent

# Default app to scrape/report/chat about when --app-id isn't passed
# (the Google Play package name, e.g. com.whatsapp). Multiple apps are
# supported — scrape more via --app-id or the Streamlit "Add another
# app" form; each is tracked separately by app_id.
TARGET_APP_ID=com.example.app

# Vector store location (Step 2 onward)
CHROMA_PERSIST_DIR=./data/chroma
